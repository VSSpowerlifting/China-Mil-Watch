---
// The standing head on an index page: label box, display title, one line of standing text and
// the folio that counts what is below it. The colophon, the series index and the second-axis
// indexes all open this way on purpose -- a magazine's back-of-book pages share a head, and
// without one shared component four screens drift into four different openings.
interface Props {
  kicker: string;
  title: string;
  lede: string;
  folio?: string; // the mono count line; omitted where there is nothing to count
  class?: string;
}
const { kicker, title, lede, folio, class: className } = Astro.props;
---

<div class:list={['max-w-content', className]}>
  <span class="kicker">{kicker}</span>
  <h1 class="font-headline mt-4 text-[clamp(2rem,4.2vw,3rem)] leading-[1.08] font-bold tracking-[-0.01em]">
    {title}
  </h1>
  <p class="mt-5 text-[1.125rem] leading-relaxed sm:text-[1.25rem]">{lede}</p>
  {folio && <p class="text-muted mt-6 font-mono text-[0.6875rem] uppercase">{folio}</p>}
</div>
