---
// Light/dark switch. The value lands on <html data-theme>, which flips
// color-scheme so every light-dark() token switches with it. No class variant.
---

<button type="button" data-theme-toggle aria-pressed="false" class="font-ui text-sm">
  <span data-theme-label>Dark</span>
</button>

<script>
  const KEY = 'theme';
  const root = document.documentElement;
  const button = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
  const label = button?.querySelector('[data-theme-label]');
  // IPR: Night Desk (dark) is the default; light is the one alternative.
  const order = ['dark', 'light'] as const;

  const read = () => {
    try {
      return localStorage.getItem(KEY) === 'light' ? 'light' : 'dark';
    } catch {
      return 'dark';
    }
  };

  const apply = (value: string) => {
    root.setAttribute('data-theme', value);
    if (label) label.textContent = value[0].toUpperCase() + value.slice(1);
    button?.setAttribute('aria-pressed', String(value === 'dark'));
  };

  apply(read());
  button?.addEventListener('click', () => {
    const next = order[(order.indexOf(read() as (typeof order)[number]) + 1) % order.length];
    try {
      localStorage.setItem(KEY, next);
    } catch {}
    apply(next);
  });
</script>
