<script>
	//<![CDATA[
	
	    // 검색
	    function srchMain(){	
	        if( "" != $("#srchStartDate").val() && "" != $("#srchEndDate").val()) {
	            if($("#srchStartDate").val() > $("#srchEndDate").val() ){
	                alert("시작일이 종료일보다 클 수 없습니다.");
	                return false;
	            }
	        }
	
	        // 검색값 세팅
	        $("#startDate").val($("#srchStartDate").val());
	        $("#endDate").val($("#srchEndDate").val());
	        $("#srchWord").val($("#srchKeyword").val());
	        if ($("#srchRepCodeType").val() != ""){
	            $("#repCodeType").val($("#srchRepCodeType").val());
	        }
	        
	        $('#formPeriod').val($('input:radio[name=period]:checked').val());
	        
	        $("#cateId").val($("input[name=sch_post_radio]:checked").val());
	        
	        $("#repCode").val($("input:checkbox[name=chkRepCode]:checked").map(function () {return this.value;}).get());
	        $('#pageIndex').val("1");
	        
	        $('#mainForm').submit();
	    }
	
	    //검색
	    function connectWordSearch(num){
	        $("#srchKeyword").val($("#connectWord"+num).text());
	        srchMain();
	    }
	
	 	// 상세조회
		function goDetailView(url, newsId) {
			$('#mainForm').attr('action', url);
			$('#mainForm').submit();
		}
	 
	 	// 상세검색 > 정부부처 > '선택한 항목'의 부처 삭제 클릭 시 체크박스도 해제
		/*
		$(document).on('click', '.select_opt ul li button', function(){
			var text = $(this).closest('li').text().replace('삭제', '');
			$('.row_item .sort label').each(function(){
				if (text == $(this).text()) {
					$('#' + $(this).attr('for')).attr('checked', false);
				}
			});
			$(this).closest('li').remove();			
		});
		*/
	    
	    $(document).ready(function() {
	    	// 상세검색 내역이 있을 경우 상세검색 펼치기
	    	if (($('#formPeriod').val() != 'year' && $('#formPeriod').val() != '') || $('#repCode').val() != ''){
	    		$('.btn_detail').trigger('click');
				// 기간검색이 직접입력일 경우 기간입력창 열기
				if ($('#formPeriod').val() == 'direct') {
					$('.date_direct').addClass('active');
				}
			}
	    	
			// 이전 검색 시 선택했던 정부부처 세팅
			//if ($('#repCodeType').val() == '정부부처') {
				var chkedOutSite = $('#repCode').val();
				if (chkedOutSite != undefined && chkedOutSite != '') {
					var arrOutSite = new Array();
					arrOutSite = chkedOutSite.split(",");
					for (var i=0; i < arrOutSite.length; i++) {
						$('input:checkbox[name=chkRepCode]').each(function(){
							if ($(this).val() === arrOutSite[i]) {
								$(this).attr('checked', true);
								$('.select_opt ul').append('<li>'+$("label[for='"+$(this).val()+"']").text()+'<button><span>삭제</span></button></li>');
							}
						});
					}
				}
				/* const data = $('#srchArea3').data('target');
				$('#srchArea3').closest('.sch_detail').find('.select_opt').removeClass('active');
				$('#srchArea3').closest('.row_item').find('.row_detail').removeClass('active');
				$('.' + data).addClass('active');
				$('#srchArea3').attr('checked', true);
			} */
	    	
			$('.sch_inp a').click(function(e){			
				e.preventDefault();
				srchMain();				
			});
			
	        // 검색어 엔터 입력
	        $('#srchKeyword').keypress(function(event){
	            if (event.which == 13) {
	                srchMain();
	            }
	        });
	        
	        $('input:radio[name=period]').change(function(){
	        	doDate($(this).val());
	        });
	        
            
	        $('.tab_nav li a').each(function(){
	        	var text = $(this).text();
            	$(this).click(function(e){
            		e.preventDefault();
            		$('#srchRepCodeType').val(text);
            	});            	
            });
	
	        
	        $("input:checkbox[name=chkRepCode], input[name=sch_post_radio]").click(function(){
	        	fn_repCodeCk();
	        });
	        
	        
	        $('#srchStartDate, #srchStartDateBt').click(function(){
	        	show_calendar('calStart', 'srchStartDate', $('#srchStartDate').val());
	        });
	        $('#srchEndDate, #srchEndDateBt').click(function(){
	        	show_calendar('calEnd', 'srchEndDate', $('#srchEndDate').val());
	        });

			$('#srchStartDate, #srchEndDate').on('focus', function(){
				if("" != $("#srchStartDate").val() && "" != $("#srchEndDate").val()) {
					if($("#srchStartDate").val() > $("#srchEndDate").val() ){
						alert("시작일이 종료일보다 클 수 없습니다.");
						$(this).val("");
						return false;
					}
				}
			});
	    });
	//]]>
	</script>
</head>

