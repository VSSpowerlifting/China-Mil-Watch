    <script nonce="sclotusinnline">
        function processCrossLink(siteId) {
            $('a').filter(function () {
                if (typeof $(this).attr('data-iscrosslink') == 'undefined'
                    && typeof $(this).attr('href') != 'undefined'
                    && $(this).attr('href').match(/^\/([a-zA-Z0-9-]+)-([0-9]+).htm$/g)) {
