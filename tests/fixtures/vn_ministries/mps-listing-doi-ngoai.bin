ht-2 top-2 right-2 lg:top-4 lg:right-4" data-v-f505a7ed><!----></div></picture></a><figcaption class="card-content flex-1 h-full flex flex-col space-y-[13px] rounded-r-[8px]"><a href="/bai-viet/viet-nam-va-myanmar-chu-trong-hop-tac-dau-tranh-voi-cac-loai-toi-pham-moi-1790933646" class=""><h2 class="text-[15px] lg:text-lg lg:font-bold text-black hover:text-bca-main-01">Việt Nam và Myanmar chú trọng hợp tác đấu tranh với các loại tội phạm mới</h2></a><p class="hidden lg:block text-[15px] text-bca-gray-700 lg:!line-clamp-3">Chiều 02/10/2026, tại Hà Nội, Thượng tướng Lê Văn Tuyến, Ủy viên Trung ương Đảng, Thứ trưởng Bộ Công an đã có buổi làm việc với Thiếu tướng Min Thu, Thứ trưởng Bộ Nội vụ Myanmar nhân dịp Đoàn đại biểu cấp cao Bộ Nội vụ Myanmar tham dự Hội nghị lãnh đạo cơ quan thực thi pháp luật các nước ASEAN về hợp tác đấu tranh với tội phạm truy nã (Hội nghị).</p><span class="hidden lg:block text-bca-gray-700 text-xs">02/10/2026</span></figcaption></figure></article><article class="card-large h-full bg-white border-b border-b-bca-gray-100 lg:border-none lg:pb-0 pb-4 lg:shadow-custom lg:rounded-[8px]" data-v-b989f2a3><figure class="h-full flex space-x-4 lg:space-x-6 lg:p-4"><a href="/bai-viet/tang-cuong-hop-tac-an-ninh-giua-viet-nam-va-cac-nuoc-asean-1790758318" class=""><picture class="relative block h-full" data-v-f505a7ed><source srcset="https://bocongan.gov.vn/media/bca-media/small/library-20260930154148-2a98088b-eb01-475e-af47-6c2df3bb3ee2-1790755948952-1841401800737477203-1841401800737477203-9927c8ac1d53596fd6912fb3e29a03ec.jpg 1x, https://bocongan.gov.vn/media/bca-media/mobile/library-20260930154148-2a98088b-eb01-475e-af47-6c2df3bb3ee2-1790755948952-1841401800737477203-1841401800737477203-9927c8ac1d53596fd6912fb3e29a03ec.jpg 2x" media="(max-width: 640px)" type="image/webp" sizes="100vw" data-v-f505a7ed><source srcset="https://bocongan.gov.vn/media/bca-media/mobile/library-20260930154148-2a98088b-eb01-475e-af47-6c2df3bb3ee2-1790755948952-1841401800737477203-1841401800737477203-9927c8ac1d53596fd6912fb3e29a03ec.jpg 1x, https://bocongan.gov.vn/media/bca-media/medium/library-20260930154148-2a98088b-eb01-475e-af47-6c2df3bb3ee2-1790755948952-1841401800737477203-1841401800737477203-9927c8ac1d53596fd6912fb3e29a03ec.jpg 2x" media="(max-width: 768px)" type="image/webp" sizes="100vw" data-v-f505a7ed><source srcset="https://bocongan.gov.vn/media/bca-media/medium/library-20260930154148-2a98088b-eb01-475e-af47-6c2df3bb3ee2-1790755948952-1841401800737477203-1841401800737477203-9927c8ac1d53596fd6912fb3e29a03ec.jpg 1x, https://bocongan.gov.vn/media/bca-media/medium/library-20260930154148-2a98088b-eb01-475e-af47-6c2df3bb3ee2-1790755948952-1841401800737477203-1841401800737477203-9927c8ac1d53596fd6912fb3e29a03ec.jpg 2x" media="(max-width: 1024px)" type="image/webp" sizes="100vw" data-v-f505a7ed><source srcset="https://bocongan.gov.vn/media/bca-media/medium/library-20260930154148-2a98088b-eb01-475e-af47-6c2df3bb3ee2-1790755948952-1841401800737477203-1841401800737477203-9927c8ac1d53596fd6912fb3e29a03ec.jpg 1x, https://bocongan.gov.vn/media/bca-media/medium/library-20260930154148-2a98088b-eb01-475e-af47-6c2df3bb3ee2-1790755948952-1841401800737477203-1841401800737477203-9927c8ac1d53596fd6912fb3e29a03ec.jpg 2x" media="(min-width: 1025px)" type="image/webp" sizes="100vw" data-v-f505a7ed><source srcset="https://bocongan.gov.vn/media/bca-media/medium/library-20260930154148-2a98088b-eb01-475e-af47-6c2df3bb3ee2-1790755948952-1841401800737477203-1841401800737477203-9927c8ac1d53596fd6912fb3e29a03ec.jpg" media="(min-width: 1025px)" type="image/webp" data-v-f505a7ed><img src="https://bocongan.gov.vn/media/bca-media/mobile/library-20260930154148-2a98088b-eb01-475e-af47-6c2df3bb3ee2-1790755948952-1841401800737477203-1841401800737477203-9927c8ac1d53596fd6912fb3e29a03ec.jpg" alt="Tăng cường hợp tác an ninh giữa Việt Nam và các nước ASEAN" loading="lazy" decoding="async" fetchpriority="high" width="376" height="268" class="placeholder lg:w-[288px] w-[103px] rounded-[8px] object-cover h-[68px] lg:h-[162px] flex-shrink-0" data-v-f505a7ed><div class="absolute flex group z-30 top-2 right-2 top-2 right-2 lg:top-4 lg:right-4" data-v-f505a7ed><!----></div></picture></a><figcaption class="card-content flex-1 h-full flex flex-col space-y-[13px] rounded-r-[8px]"><a href="/bai-viet/tang-cuong-hop-tac-an-ninh-giua-viet-nam-va-cac-nuoc-asean-1790758318" class=""><h2 class="text-[15px] lg:text-lg lg:font-bold text-black hover:text-bca-main-01">Tăng cường hợp tác an ninh giữa Việt Nam và các nước ASEAN</h2></a><p class="hidden lg:block text-[15px] text-bca-gray-700 lg:!line-clamp-3">Bên lề Hội nghị Lãnh đạo cấp cao cơ quan thực thi pháp luật các nước ASEAN về hợp tác đấu tranh với tội phạm truy nã, ngày 30/9/2026, tại Hà Nội, Đại tướng Lương Tam Quang, Ủy viên Bộ Chính trị, Bộ trưởng Bộ Công an đã có các buổi tiếp song phương Phó Thủ tướng, Bộ trưởng Bộ Nội vụ Vương quốc Campuchia Sar Sokha và ngài Dato Seri Setia Awang Haji Sufian bin Haji Sabtu, Bộ trưởng, Văn phòng Thủ tướng kiêm Chủ tịch Ủy ban An ninh quốc gia Brunei Darussalam</p><span class="hidden lg:block text-bca-gray-700 text-xs">30/09/2026</span></figcaption></figure></article><article class="card-large h-full bg-white border-b border-b-bca-gray-100 lg:border-none lg:pb-0 pb-4 lg:shadow-custom lg:rounded-[8px]" data-v-b989f2a3><figure class="h-full flex space-x-4 lg:space-x-6 lg:p-4"><a href="/bai-viet/khai-mac-hoi-nghi-lanh-dao-co-quan-thuc-thi-phap-luat-cac-nuoc-asean-ve-hop-tac-dau-tranh-voi-toi-pham-truy-na-1790748442" class=""><picture class="relative block h-full" data-v-f505a7ed><source srcset="https://bocongan.gov.vn/media/bca-media/small/library-20260930125547-64b7004d-414f-4379-8738-f299d1a5c920-1790735281878-1841401800737477203-1841401800737477203-afea99229867602b20af630235e02c40.jpg 1x, https://bocongan.gov.vn/media/bca-media/mobile/library-20260930125547-64b7004d-414f-4379-8738-f299d1a5c920-1790735281878-1841401800737477203-1841401800737477203-afea99229867602b20af630235e02c40.jpg 2x" media="(max-width: 640px)" type="image/webp" sizes="100vw" data-v-f505a7ed><source srcset="https://bocongan.gov.vn/media/bca-media/mobile/library-20260930125547-64b7004d-414f-4379-8738-f299d1a5c920-1790735281878-1841401800737477203-1841401800737477203-afea99229867602b20af630235e02c40.jpg 1x, https://bocongan.gov.vn/media/bca-media/medium/library-20260930125547-64b7004d-414f-4379-8738-f299d1a5c920-1790735281878-1841401800737477203-1841401800737477203-afea99229867602b20af630235e02c40.jpg 2x" media="(max-width: 768px)" type="image/webp" sizes="100vw" data-v-f505a7ed><source srcset="https://bocongan.gov.vn/media/bca-media/medium/library-20260930125547-64b7004d-414f-4379-8738-f299d1a5c920-1790735281878-1841401800737477203-1841401800737477203-afea99229867602b20af630235e02c40.jpg 1x, https://bocongan.gov.vn/media/bca-media/medium/library-20260930125547-64b7004d-414f-4379-8738-f299d1a5c920-1790735281878-1841401800737477203-1841401800737477203-afea99229867602b20af630235e02c40.jpg 2x" media="(max-width: 1024px)" type="image/webp" sizes="100vw" data-v-f505a7ed><source srcset="https://bocongan.gov.vn/media/bca-media/medium/library-20260930125547-64b7004d-414f-4379-8738-f299d1a5c920-1790735281878-1841401800737477203-1841401800737477203-afea99229867602b20af630235e02c40.jpg 1x, https://bocongan.gov.vn/media/bca-media/medium/library-20260930125547-64b7004d-414f-4379-8738-f299d1a5c920-1790735281878-1841401800737477203-1841401800737477203-afea99229867602b20af630235e02c40.jpg 2x" media="(min-width: 1025px)" type="image/webp" sizes="100vw" data-v-f505a7ed><source srcset="https://bocongan.gov.vn/media/bca-media/medium/library-20260930125547-64b7004d-414f-4379-8738-f299d1a5c920-1790735281878-1841401800737477203-1841401800737477203-afea99229867602b20af630235e02c40.jpg" media="(min-width: 1025px)" type="image/webp" data-v-f505a7ed><img src="https://bocongan.gov.vn/media/bca-media/mobile/library-20260930125547-64b7004d-414f-4379-8738-f299d1a5c920-1790735281878-1841401800737477203-1841401800737477203-afea99229867602b20af630235e02c40.jpg" alt="Khai mạc Hội nghị lãnh đạo cơ quan thực thi pháp luật các nước ASEAN về hợp tác đấu tranh với tội phạm truy nã" loading="lazy" decoding="async" fetchpriority="high" width="376" height="268" class="placeholder lg:w-[288px] w-[103px] rounded-[8px] object-cover h-[68px] lg:h-[162px] flex-shrink-0" data-v-f505a7ed><div class="absolute flex group z-30 top-2 right-2 top-2 right-2 lg:top-4 lg:right-4" data-v-f505a7ed><!----></div></picture></a><figcaption class="card-content flex-1 h-full flex flex-col space-y-[13px] rounded-r-[8px]"><a href="/bai-viet/khai-mac-hoi-nghi-lanh-dao-co-quan-thuc-thi-phap-luat-cac-nuoc-asean-ve-hop-tac-dau-tranh-voi-toi-pham-truy-na-1790748442" class=""><h2 class="text-[15px] lg:text-lg lg:font-bold text-black hover:text-bca-main-01">Khai mạc Hội nghị lãnh đạo cơ quan thực thi pháp luật các nước ASEAN về hợp tác đấu tranh với tội phạm truy nã</h2></a><p class="hidden lg:block text-[15px] text-bca-gray-700 lg:!line-clamp-3">Sáng ngày 30/9/2026, tại Hà Nội, Hội nghị lãnh đạo cơ quan thực thi pháp luật các nước ASEAN về hợp tác đấu tranh với tội phạm truy nã do Bộ Công an Việt Nam chủ trì tổ chức với chủ đề &quot;Tăng cường hợp tác khu vực vì một ASEAN thượng tôn pháp luật và không có tội phạm truy nã&quot; đã khai mạc.</p><span class="hidden lg:block text-bca-gray-700 text-xs">30/09/2026</span></figcaption></figure></article><article class="card-large h-full bg-white border-b border-b-bca-gray-100 lg:border-none lg:pb-0 pb-4 lg:shadow-custom lg:rounded-[8px]" data-v-b989f2a3><figure class="h-full flex space-x-4 lg:space-x-6 lg:p-4"><a href="/bai-viet/thuc-day-hop-tac-an-ninh-mang-va-chuyen-doi-so-viet-nam-singapore-1790579880" class=""><picture class="relative block h-full" data-v-f505a7ed><source srcset="https://bocongan.gov.vn/media/bca-media/small/library-20260928140548-8201b93e-cbdd-4f88-95c0-012dafb70fed-1790571793327-1841401800737477203-1841401800737477203-cc8a5e28e87d255358ba8f5f03165b48.jpg 1x, https://bocongan.gov.vn/media/bca-media/mobile/library-20260928140548-8201b93e-cbdd-4f88-95c0-012dafb70fed-1790571793327-1841401800737477203-1841401800737477203-cc8a5e28e87d255358ba8f5f03165b48.jpg 2x" media="(max-width: 640px)" type="image/webp" sizes="100vw" data-v-f505a7ed><source srcset="https://bocongan.gov.vn/media/bca-media/mobile/library-20260928140548-8201b93e-cbdd-4f88-95c0-012dafb70fed-1790571793327-1841401800737477203-1841401800737477203-cc8a5e28e87d255358ba8f5f03165b48.jpg 1x, https://bocongan.gov.vn/media/bca-media/medium/library-20260928140548-8201b93e-cbdd-4f88-95c0-012dafb70fed-1790571793327-1841401800737477203-1841401800737477203-cc8a5e28e87d255358ba8f5f03165b48.jpg 2x" media="(max-width: 768px)" type="image/webp" sizes="100vw" data-v-f505a7ed><source srcset="https://bocongan.gov.vn/media/bca-media/medium/library-20260928140548-8201b93e-cbdd-4f88-95c0-012dafb70fed-1790571793327-1841401800737477203-1841401800737477203-cc8a5e28e87d255358ba8f5f03165b48.jpg 1x, https://bocongan.gov.vn/media/bca-media/medium/library-20260928140548-8201b93e-cbdd-4f88-95c0-012dafb70fed-1790571793327-1841401800737477203-1841401800737477203-cc8a5e28e87d255358ba8f5f03165b48.jpg 2x" media="(max-width: 1024px)" type="image/webp" sizes="100vw" data-v-f505a7ed><source srcset="https://bocongan.gov.vn/media/bca-media/medium/library-20260928140548-8201b93e-cbdd-4f88-95c0-012dafb70fed-1790571793327-1841401800737477203-1841401800737477203-cc8a5e28e87d255358ba8f5f03165b48.jpg 1x, https://bocongan.gov.vn/media/bca-media/medium/library-20260928140548-8201b93e-cbdd-4f88-95c0-012dafb70fed-1790571793327-1841401800737477203-1841401800737477203-cc8a5e28e87d255358ba8f5f03165b48.jpg 2x" media="(min-width: 1025px)" type="image/webp" sizes="100vw" data-v-f505a7ed><source srcset="https://bocongan.gov.vn/media/bca-media/medium/library-20260928140548-8201b93e-cbdd-4f88-95c0-012dafb70fed-1790571793327-1841401800737477203-1841401800737477203-cc8a5e28e87d255358ba8f5f03165b48.jpg" media="(min-width: 1025px)" type="image/webp" data-v-f505a7ed><img src="https://bocongan.gov.vn/media/bca-media/mobile/library-20260928140548-8201b93e-cbdd-4f88-95c0-012dafb70fed-1790571793327-1841401800737477203-1841401800737477203-cc8a5e28e87d255358ba8f5f03165b48.jpg" alt="Thúc đẩy hợp tác an ninh mạng và chuyển đổi số Việt Nam - Singapore" loading="lazy" decoding="async" fetchpriority="high" width="376" height="268" class="placeholder lg:w-[288px] w-[103px] rounded-[8px] object-cover h-[68px] lg:h-[162px] flex-shrink-0" data-v-f505a7ed><div class="absolute flex group z-30 top-2 right-2 top-2 right-2 lg:top-4 lg:right-4" data-v-f505a7ed><!----></div></picture></a><figcaption class="card-content flex-1 h-full flex flex-col space-y-[13px] rounded-r-[8px]"><a href="/bai-viet/thuc-day-hop-tac-an-ninh-mang-va-chuyen-doi-so-viet-nam-singapore-1790579880" class=""><h2 class="text-[15px] lg:text-lg lg:font-bold text-black hover:text-bca-main-01">Thúc đẩy hợp tác an ninh mạng và chuyển đổi số Việt Nam - Singapore</h2></a><p class="hidden lg:block text-[15px] text-bca-gray-700 lg:!line-clamp-3">Sáng ngày 28/9/2026, tại Hà Nội, Thượng tướng Phạm Thế Tùng, Ủy viên Trung ương Đảng, Thứ trưởng Bộ Công an đã tiếp Đại sứ Singapore tại Việt Nam Ra-pan Sing.</p><span class="hidden lg:block text-bca-gray-700 text-xs">28/09/2026</span></figcaption></figure></article><article class="card-large h-full bg-white border-b border-b-bca-gray-100 lg:border-none lg:pb-0 pb-4 lg:shadow-custom lg:rounded-[8px]" data-v-b989f2a3><figure class="h-full flex space-x-4 lg:space-x-6 lg:p-4"><a href="/bai-viet/viet-nam-canada-thuc-day-hop-tac-an-ninh-thuc-thi-phap-luat-1790397583" class=""><picture class="relative block h-full" data-v-f505a7ed><source srcset="https://bocongan.gov.vn/media/bca-media/small/library-20260926112927-005a7590-c8f1-4ddd-be2e-af6336f8ee5e-02.jpg 1x, https://bocongan.gov.vn/media/bca-media/mobile/library-20260926112927-005a7590-c8f1-4ddd-be2e-af6336f8ee5e-02.jpg 2x" media="(max-width: 640px)" type="image/webp" sizes="100vw" data-v-f505a7ed><source srcset="https://bocongan.gov.vn/media/bca-media/mobile/library-20260926112927-005a7590-c8f1-4ddd-be2e-af6336f8ee5e-02.jpg 1x, https://bocongan.gov.vn/media/bca-media/medium/library-20260926112927-005a7590-c8f1-4ddd-be2e-af6336f8ee5e-02.jpg 2x" media="(max-width: 768px)" type="image/webp" sizes="100vw" data-v-f505a7ed><source srcset="https://bocongan.gov.vn/media/bca-media/medium/library-20260926112927-005a7590-c8f1-4ddd-be2e-af6336f8ee5e-02.jpg 1x, https://bocongan.gov.vn/media/bca-media/medium/library-20260926112927-005a7590-c8f1-4ddd-be2e-af6336f8ee5e-02.jpg 2x" media="(max-width: 1024px)" type="image/webp" sizes="100vw" data-v-f505a7ed><source srcset="https://bocongan.gov.vn/media/bca-media/medium/library-20260926112927-005a7590-c8f1-4ddd-be2e-af6336f8ee5e-02.jpg 1x, https://bocongan.gov.vn/media/bca-media/medium/library-20260926112927-005a7590-c8f1-4ddd-be2e-af6336f8ee5e-02.jpg 2x" media="(min-width: 1025px)" type="image/webp" sizes="100vw" data-v-f505a7ed><source srcset="https://bocongan.gov.vn/media/bca-media/medium/library-20260926112927-005a7590-c8f1-4ddd-be2e-af6336f8ee5e-02.jpg" media="(min-width: 1025px)" type="image/webp" data-v-f505a7ed><img src="https://bocongan.gov.vn/media/bca-media/mobile/library-20260926112927-005a7590-c8f1-4ddd-be2e-af6336f8ee5e-02.jpg" alt="Việt Nam – Canada thúc đẩy hợp tác an ninh, thực thi pháp luật" loading="lazy" decoding="async" fetchpriority="high" width="376" height="268" class="placeholder lg:w-[288px] w-[103px] rounded-[8px] object-cover h-[68px] lg:h-[162px] flex-shrink-0" data-v-f505a7ed><div class="absolute flex group z-30 top-2 right-2 top-2 right-2 lg:top-4 lg:right-4" data-v-f505a7ed><!----></div></picture></a><figcaption class="card-content flex-1 h-full flex flex-col space-y-[13px] rounded-r-[8px]"><a href="/bai-viet/viet-nam-canada-thuc-day-hop-tac-an-ninh-thuc-thi-phap-luat-1790397583" class=""><h2 class="text-[15px] lg:text-lg lg:font-bold text-black hover:text-bca-main-01">Việt Nam – Canada thúc đẩy hợp tác an ninh, thực thi pháp luật</h2></a><p class="hidden lg:block text-[15px] text-bca-gray-700 lg:!line-clamp-3">Nhân dịp tháp tùng Tổng Bí thư, Chủ tịch nước Tô Lâm và Đoàn đại biểu cấp cao Việt Nam thăm cấp Nhà nước tới Canada, sáng 25/9/2026 (theo giờ địa phương), tại thủ đô Ottawa, Đại tướng Lương Tam Quang, Uỷ viên Bộ Chính trị, Bộ trưởng Bộ Công an Việt Nam đã có cuộc hội đàm với Ngài Gary Anandasangaree, Bộ trưởng Bộ An toàn công cộng Canada, cùng sự tham dự của đại diện lãnh đạo Cơ quan Biên mậu (CBSA) và Cảnh sát Hoàng gia Canada (RCMP). Tham dự Hội đàm, còn có đại diện lãnh đạo các đơn vị chức năng Bộ Công an Việt Nam.</p><span class="hidden lg:block text-bca-gray-700 text-xs">26/09/2026</span></figcaption></figure></article><article class="card-large h-full bg-white border-b border-b-bca-gray-100 lg:border-none lg:pb-0 pb-4 lg:shadow-custom lg:rounded-[8px]" data-v-b989f2a3><figure class="h-full flex space-x-4 lg:space-x-6 lg:p-4"><a href="/bai-viet/thuc-day-hop-tac-phong-chong-lua-dao-truc-tuyen-mua-ban-nguoi-1790323608" class=""><picture class="relative block h-full" data-v-f505a7ed><source srcset="https://bocongan.gov.vn/media/bca-media/small/library-20260925145732-7ccf7c24-9750-4014-a7c4-61fb8ec79dc9-img-1876.JPG 1x, https://bocongan.gov.vn/media/bca-media/mobile/library-20260925145732-7ccf7c24-9750-4014-a7c4-61fb8ec79dc9-img-1876.JPG 2x" media="(max-width: 640px)" type="image/webp" sizes="100vw" data-v-f505a7ed><source srcset="https://bocongan.gov.vn/media/bca-media/mobile/library-20260925145732-7ccf7c24-9750-4014-a7c4-61fb8ec79dc9-img-1876.JPG 1x, https://bocongan.gov.vn/media/bca-media/medium/library-20260925145732-7ccf7c24-9750-4014-a7c4-61fb8ec79dc9-img-1876.JPG 2x" media="(max-width: 768px)" type="image/webp" sizes="100vw" data-v-f505a7ed><source srcset="https://bocongan.gov.vn/media/bca-media/medium/library-20260925145732-7ccf7c24-9750-4014-a7c4-61fb8ec79dc9-img-1876.JPG 1x, https://bocongan.gov.vn/media/bca-media/medium/library-20260925145732-7ccf7c24-9750-4014-a7c4-61fb8ec79dc9-img-1876.JPG 2x" media="(max-width: 1024px)" type="image/webp" sizes="100vw" data-v-f505a7ed><source srcset="https://bocongan.gov.vn/media/bca-media/medium/library-20260925145732-7ccf7c24-9750-4014-a7c4-61fb8ec79dc9-img-1876.JPG 1x, https://bocongan.gov.vn/media/bca-media/medium/library-20260925145732-7ccf7c24-9750-4014-a7c4-61fb8ec79dc9-img-1876.JPG 2x" media="(min-width: 1025px)" type="image/webp" sizes="100vw" data-v-f505a7ed><source srcset="https://bocongan.gov.vn/media/bca-media/medium/library-20260925145732-7ccf7c24-9750-4014-a7c4-61fb8ec79dc9-img-1876.JPG" media="(min-width: 1025px)" type="image/webp" data-v-f505a7ed><img src="https://bocongan.gov.vn/media/bca-media/mobile/library-20260925145732-7ccf7c24-9750-4014-a7c4-61fb8ec79dc9-img-1876.JPG" alt="Thúc đẩy hợp tác phòng chống lừa đảo trực tuyến, mua bán người" loading="lazy" decoding="async" fetchpriority="high" width="376" height="268" class="placeholder lg:w-[288px] w-[103px] rounded-[8px] object-cover h-[68px] lg:h-[162px] flex-shrink-0" data-v-f505a7ed><div class="absolute flex group z-30 top-2 right-2 top-2 right-2 lg:top-4 lg:right-4" data-v-f505a7ed><!----></div></picture></a><figcaption class="card-content flex-1 h-full flex flex-col space-y-[13px] rounded-r-[8px]"><a href="/bai-viet/thuc-day-hop-tac-phong-chong-lua-dao-truc-tuyen-mua-ban-nguoi-1790323608" class=""><h2 class="text-[15px] lg:text-lg lg:font-bold text-black hover:text-bca-main-01">Thúc đẩy hợp tác phòng chống lừa đảo trực tuyến, mua bán người</h2></a><p class="hidden lg:block text-[15px] text-bca-gray-700 lg:!line-clamp-3">Trong khuôn khổ chuyến thăm, làm việc tại Vương quốc Campuchia và dự Hội nghị quốc tế về đấu tranh phòng, chống lừa đảo trực tuyến (ICCOS 2026) từ ngày 23-24/9/2026, Thượng tướng Nguyễn Văn Long, Uỷ viên Trung ương Đảng, Thứ trưởng Bộ Công an đã có các hoạt động đối ngoại song phương với lãnh đạo cơ quan cảnh sát, thực thi pháp luật nước chủ nhà và các thành viên tham dự Hội nghị.</p><span class="hidden lg:block text-bca-gray-700 text-xs">24/09/2026</span></figcaption></figure></article><article class="card-large h-full bg-white border-b border-b-bca-gray-100 lg:border-none lg:pb-0 pb-4 lg:shadow-custom lg:rounded-[8px]" data-v-b989f2a3><figure class="h-full flex space-x-4 lg:space-x-6 lg:p-4"><a href="/bai-viet/viet-nam-gia-tang-dong-gop-trong-dau-tranh-phong-chong-lua-dao-truc-tuyen-1790323191" class=""><picture class="relative block h-full" data-v-f505a7ed><source srcset="https://bocongan.gov.vn/media/bca-media/small/library-20260925145733-997f7e97-8926-4de7-8bb4-e709acf09461-dsc-2786.JPG 1x, https://bocongan.gov.vn/media/bca-media/mobile/library-20260925145733-997f7e97-8926-4de7-8bb4-e709acf09461-dsc-2786.JPG 2x" media="(max-width: 640px)" type="image/webp" sizes="100vw" data-v-f505a7ed><source srcset="https://bocongan.gov.vn/media/bca-media/mobile/library-20260925145733-997f7e97-8926-4de7-8bb4-e709acf09461-dsc-2786.JPG 1x, https://bocongan.gov.vn/media/bca-media/medium/library-20260925145733-997f7e97-8926-4de7-8bb4-e709acf09461-dsc-2786.JPG 2x" media="(max-width: 768px)" type="image/webp" sizes="100vw" data-v-f505a7ed><source srcset="https://bocongan.gov.vn/media/bca-media/medium/library-20260925145733-997f7e97-8926-4de7-8bb4-e709acf09461-dsc-2786.JPG 1x, https://bocongan.gov.vn/media/bca-media/medium/library-20260925145733-997f7e97-8926-4de7-8bb4-e709acf09461-dsc-2786.JPG 2x" media="(max-width: 1024px)" type="image/webp" sizes="100vw" data-v-f505a7ed><source srcset="https://bocongan.gov.vn/media/bca-media/medium/library-20260925145733-997f7e97-8926-4de7-8bb4-e709acf09461-dsc-2786.JPG 1x, https://bocongan.gov.vn/media/bca-media/medium/library-20260925145733-997f7e97-8926-4de7-8bb4-e709acf09461-dsc-2786.JPG 2x" media="(min-width: 1025px)" type="image/webp" sizes="100vw" data-v-f505a7ed><source srcset="https://bocongan.gov.vn/media/bca-media/medium/library-20260925145733-997f7e97-8926-4de7-8bb4-e709acf09461-dsc-2786.JPG" media="(min-width: 1025px)" type="image/webp" data-v-f505a7ed><img src="https://bocongan.gov.vn/media/bca-media/mobile/library-20260925145733-997f7e97-8926-4de7-8bb4-e709acf09461-dsc-2786.JPG" alt="Việt Nam gia tăng đóng góp trong đấu tranh phòng, chống lừa đảo trực tuyến" loading="lazy" decoding="async" fetchpriority="high" width="376" height="268" class="placeholder lg:w-[288px] w-[103px] rounded-[8px] object-cover h-[68px] lg:h-[162px] flex-shrink-0" data-v-f505a7ed><div class="absolute flex group z-30 top-2 right-2 top-2 right-2 lg:top-4 lg:right-4" data-v-f505a7ed><!----></div></picture></a><figcaption class="card-content flex-1 h-full flex flex-col space-y-[13px] rounded-r-[8px]"><a href="/bai-viet/viet-nam-gia-tang-dong-gop-trong-dau-tranh-phong-chong-lua-dao-truc-tuyen-1790323191" class=""><h2 class="text-[15px] lg:text-lg lg:font-bold text-black hover:text-bca-main-01">Việt Nam gia tăng đóng góp trong đấu tranh phòng, chống lừa đảo trực tuyến</h2></a><p class="hidden lg:block text-[15px] text-bca-gray-700 lg:!line-clamp-3">Trong các ngày 23 và 24/9/2026, tại Thủ đô Phnom Penh, Vương quốc Campuchia, Đoàn đại biểu cấp cao Bộ Công an Việt Nam do Thượng tướng Nguyễn Văn Long, Uỷ viên Trung ương Đảng, Thứ trưởng Bộ Công an làm Trưởng đoàn đã tham dự Hội nghị quốc tế về đấu tranh phòng, chống lừa đảo trực tuyến (ICCOS 2026).</p><span class="hidden lg:block text-bca-gray-700 text-xs">24/09/2026</span></figcaption></figure></article><article class="card-large h-full bg-white border-b border-b-bca-gray-100 lg:border-none lg:pb-0 pb-4 lg:shadow-custom lg:rounded-[8px]" data-v-b989f2a3><figure class="h-full flex space-x-4 lg:space-x-6 lg:p-4"><a href="/bai-viet/bo-cong-an-viet-nam-day-manh-tham-gia-hoat-dong-gin-giu-hoa-binh-1790132836" class=""><picture class="relative block h-full" data-v-f505a7ed><source srcset="https://bocongan.gov.vn/media/bca-media/small/library-20260923095755-33276c14-740e-4e31-b737-e6b2004ca584-001-bt-luong-tam-quang-lam-viec-voi-pho-tong-tk-lhq-phu-trach-gin-giu-hoa-binh.jpg 1x, https://bocongan.gov.vn/media/bca-media/mobile/library-20260923095755-33276c14-740e-4e31-b737-e6b2004ca584-001-bt-luong-tam-quang-lam-viec-voi-pho-tong-tk-lhq-phu-trach-gin-giu-hoa-binh.jpg 2x" media="(max-width: 640px)" type="image/webp" sizes="100vw" data-v-f505a7ed><source srcset="https://bocongan.gov.vn/media/bca-media/mobile/library-20260923095755-33276c14-740e-4e31-b737-e6b2004ca584-001-bt-luong-tam-quang-lam-viec-voi-pho-tong-tk-lhq-phu-trach-gin-giu-hoa-binh.jpg 1x, https://bocongan.gov.vn/media/bca-media/medium/library-20260923095755-33276c14-740e-4e31-b737-e6b2004ca584-001-bt-luong-tam-quang-lam-viec-voi-pho-tong-tk-lhq-phu-trach-gin-giu-hoa-binh.jpg 2x" media="(max-width: 768px)" type="image/webp" sizes="100vw" data-v-f505a7ed><source srcset="https://bocongan.gov.vn/media/bca-media/medium/library-20260923095755-33276c14-740e-4e31-b737-e6b2004ca584-001-bt-luong-tam-quang-lam-viec-voi-pho-tong-tk-lhq-phu-trach-gin-giu-hoa-binh.jpg 1x, https://bocongan.gov.vn/media/bca-media/medium/library-20260923095755-33276c14-740e-4e31-b737-e6b2004ca584-001-bt-luong-tam-quang-lam-viec-voi-pho-tong-tk-lhq-phu-trach-gin-giu-hoa-binh.jpg 2x" media="(max-width: 1024px)" type="image/webp" sizes="100vw" data-v-f505a7ed><source srcset="https://bocongan.gov.vn/media/bca-media/medium/library-20260923095755-33276c14-740e-4e31-b737-e6b2004ca584-001-bt-luong-tam-quang-lam-viec-voi-pho-tong-tk-lhq-phu-trach-gin-giu-hoa-binh.jpg 1x, https://bocongan.gov.vn/media/bca-media/medium/library-20260923095755-33276c14-740e-4e31-b737-e6b2004ca584-001-bt-luong-tam-quang-lam-viec-voi-pho-tong-tk-lhq-phu-trach-gin-giu-hoa-binh.jpg 2x" media="(min-width: 1025px)" type="image/webp" sizes="100vw" data-v-f505a7ed><source srcset="https://bocongan.gov.vn/media/bca-media/medium/library-20260923095755-33276c14-740e-4e31-b737-e6b2004ca584-001-bt-luong-tam-quang-lam-viec-voi-pho-tong-tk-lhq-phu-trach-gin-giu-hoa-binh.jpg" media="(min-width: 1025px)" type="image/webp" data-v-f505a7ed><img src="https://bocongan.gov.vn/media/bca-media/mobile/library-20260923095755-33276c14-740e-4e31-b737-e6b2004ca584-001-bt-luong-tam-quang-lam-viec-voi-pho-tong-tk-lhq-phu-trach-gin-giu-hoa-binh.jpg" alt="Bộ Công an Việt Nam đẩy mạnh tham gia hoạt động gìn giữ hòa bình" loading="lazy" decoding="async" fetchpriority="high" width="376" height="268" class="placeholder lg:w-[288px] w-[103px] rounded-[8px] object-cover h-[68px] lg:h-[162px] flex-shrink-0" data-v-f505a7ed><div class="absolute flex group z-30 top-2 right-2 top-2 right-2 lg:top-4 lg:right-4" data-v-f505a7ed><!----></div></picture></a><figcaption class="card-content flex-1 h-full flex flex-col space-y-[13px] rounded-r-[8px]"><a href="/bai-viet/bo-cong-an-viet-nam-day-manh-tham-gia-hoat-dong-gin-giu-hoa-binh-1790132836" class=""><h2 class="text-[15px] lg:text-lg lg:font-bold text-black hover:text-bca-main-01">Bộ Công an Việt Nam đẩy mạnh tham gia hoạt động gìn giữ hòa bình</h2></a><p class="hidden lg:block text-[15px] text-bca-gray-700 lg:!line-clamp-3">Tiếp tục các hoạt động trong chuyến công tác cùng Đoàn đại biểu cấp cao Việt Nam tháp tùng Tổng Bí thư, Chủ tịch nước Tô Lâm tham dự Phiên thảo luận chung cấp cao Đại hội đồng Liên hợp quốc khóa 81, hoạt động song phương tại Hoa Kỳ, ngày 22/9/206 (theo giờ địa phương), tại New York, Đại tướng Lương Tam Quang, Uỷ viên Bộ Chính trị, Bộ trưởng Bộ Công an đã có các cuộc gặp song phương với các quan chức Liên hợp quốc (LHQ) và tiếp lãnh đạo một số tập đoàn của Hoa Kỳ.</p><span class="hidden lg:block text-bca-gray-700 text-xs">23/09/2026</span></figcaption></figure></article><!--]--></div><div class="flex px-3 py-3.5 mt-6 lg:border-t border-bca-gray-200 lg:mt-8" data-v-b989f2a3><div class="flex flex-1 justify-center shrink-0" data-v-b989f2a3><div class="flex items-center gap-1" show-first show-last data-v-b989f2a3><!--[--><button type="button" disabled class="focus:outline-none focus